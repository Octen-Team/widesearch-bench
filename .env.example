# Copy to .env and fill in. `set -a; source .env; set +a` before running.
# .env is gitignored; this template is not.

# --- required for the four published arms ---
OCTEN_API_KEY=            # octen-broad-search        https://octen.ai
EXA_API_KEY=              # exa-instant-agent         https://exa.ai
TAVILY_API_KEY=           # tavily-ultrafast-agent    https://tavily.com
PARALLEL_API_KEY=         # parallel-turbo-agent      https://parallel.ai

# --- required for the answering model ---
OPENAI_API_KEY=           # the reader                https://platform.openai.com
WIDESEARCH_READER_MODEL=openai:gpt-5-mini

# --- optional ---
# WIDESEARCH_OPENAI_EFFORT=low       # reasoning effort; "low" is what we published
# WIDESEARCH_HIGHLIGHT_TOKENS=512    # per-snippet budget, identical for every arm
# OPENROUTER_API_KEY=                # only to route the reader via OpenRouter
#                                    # (then set WIDESEARCH_READER_MODEL=openrouter/<vendor>/<model>)
# BRAVE_API_KEY=                     # only for the unpublished brave adapter
